# Backend environment example
PORT=3000
# Path to SQLite database file (relative to the process working directory)
DATABASE_FILE=database/launchpad.db
NODE_ENV=development

# Password for the initial admin user. Used only when that user does not exist yet.
# Leave unset (or empty) to generate a random password and print it once during init.
# There is no hardcoded default.
INIT_ADMIN_PASSWORD=

# In-memory session lifetime in hours. Defaults to 8 when unset or invalid.
SESSION_TTL_HOURS=8

# Express trust proxy setting. The login rate limit keys attempts by req.ip.
# Leave unset when clients connect to the API directly.
# Behind one reverse proxy, set 1 so X-Forwarded-For is the client address.
# Other values follow Express: true, a hop count, loopback, or a trusted IP/subnet.
# TRUST_PROXY=1

# Barcode scan limit for each signed-in user. Defaults are 60 scans per 60 seconds.
# Restart the server after changing these.
BARCODE_RATE_LIMIT_MAX=60
BARCODE_RATE_LIMIT_WINDOW_SECONDS=60

# Scan locations that advance a production stage. Pairs are Location=Stage Name, separated by semicolons.
# Leave unset for Quality=Quality Control and Dispatch=Shipping. Set empty to disable advancement.
# Finishing is not a default scan location. Add it in Barcode Settings if a station should
# advance that stage without moving the department.
# BARCODE_LOCATION_STAGES=Quality=Quality Control;Dispatch=Shipping

# Delivery due times are wall-clock values in DELIVERY_TIMEZONE.
# When this variable is unset, the code default is UTC. Set the shop calendar here.
# Before the cutoff on a weekday, the due time is that cutoff today. Otherwise it is the cutoff on the next Monday-Friday.
WILL_CALL_CUTOFF=15:00
CARRIER_CUTOFF=14:00
DELIVERY_TIMEZONE=America/New_York

# Hours ahead of now that count as due soon on the delivery list. Default 1.
# Completed deliveries are not marked overdue. Restart the server after changing it.
DUE_SOON_HOURS=1

# Minutes before a delivery due time that create an in-app "due soon" notification. Default 60.
# When this is unset, notifications use DUE_SOON_HOURS, so the list flag and the alert match.
# Set this only when the notification window should differ from the list. Restart to apply.
DELIVERY_DUE_SOON_MINUTES=60

# How often the in-process scheduler checks delivery due times, in seconds. Default 60. Minimum 1.
# The timer does not keep the process alive on its own. Restart the server after changing it.
NOTIFICATION_CHECK_INTERVAL_SECONDS=60

# Optional in-app notification email. Off by default. That stub does not send mail.
# Set to true only to exercise the stub. Those notification events are still not emailed.
EMAIL_NOTIFICATIONS=false

# Mail for files shared with a customer. Leave SMTP_HOST unset when mail is not set up.
# Files are still shared in Launchpad, and the send dialog says email is not set up.
# Do not commit real passwords. SMTP_PASS belongs only in the server environment.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=files@example.com
# SMTP_SECURE=false
# Public site address used in the sign-in link. No trailing path. Example: https://launchpad.example.com
# PUBLIC_APP_URL=
# How many file-share and test emails one user may send per window. Defaults are 30 per 15 minutes.
# A share over the limit is still saved. The test-email route returns HTTP 429.
# EMAIL_RATE_LIMIT_MAX=30
# EMAIL_RATE_LIMIT_WINDOW_MS=900000
# Connection, greeting, and socket timeout in milliseconds. Default 12000.
# SMTP_TIMEOUT_MS=12000
# Tests only. json or stream uses a nodemailer mock instead of SMTP. Ignored unless NODE_ENV=test.
# With NODE_ENV=test, MAIL_TRANSPORT=json, and SMTP_HOST set, the server warns at startup.
# MAIL_TRANSPORT=

# Customer-requested due times. Weekdays only, inclusive windows, 15 minute increments.
# Will Call pickup is 8:00 AM–5:00 PM. Deliveries (Accent Truck, UPS, and any other
# method that is not Will Call) are 9:00 AM–4:00 PM.
# Same-day cutoffs above stay 15:00 and 14:00. Both are inside these windows, so a
# blank delivery due time is still the cutoff rather than the end of the window.
WILL_CALL_WINDOW_START=08:00
WILL_CALL_WINDOW_END=17:00
DELIVERY_WINDOW_START=09:00
DELIVERY_WINDOW_END=16:00
DELIVERY_SLOT_MINUTES=15

# Uploaded order files. Relative paths are resolved from the backend folder, not the web root.
# The default is ../data/uploads (the repository data/uploads directory).
UPLOAD_DIR=../data/uploads
# Maximum size of one file, in megabytes. Decimals are allowed.
MAX_UPLOAD_MB=25
# Maximum files accepted in one multipart request.
MAX_UPLOAD_FILES=20
# How many files one user may have that are not yet attached to an order. Default 30.
MAX_UNATTACHED_UPLOADS=30
# Unattached uploads older than this many hours are deleted. Default 24.
UPLOAD_ORPHAN_HOURS=24
# How often the unattached-file sweep runs, in seconds. Default 3600. The timer does not keep the process alive.
UPLOAD_SWEEP_INTERVAL_SECONDS=3600
